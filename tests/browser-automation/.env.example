# GTH Browser Automation Configuration Example
# Copy this file to .env and adjust values for your environment

# =========================
# Browser Configuration
# =========================

# Comma-separated list of allowed test domains (security boundary)
# Only URLs with these hosts will be allowed
ALLOWED_HOSTS=localhost,127.0.0.1,gth.local,gth-test.internal

# Path to Chrome/Chromium executable (leave empty for default)
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_EXECUTABLE_PATH=

# Launch browser in headless mode (false to see browser window)
HEADLESS=false

# Use persistent context (reuses session across navigation)
PERSISTENT_CONTEXT=true

# User data directory for persistent context
# Stores cookies, cache, and session data
USER_DATA_DIR=./session-data

# Browser window size
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# =========================
# Target Configuration
# =========================

# Base URL for test target
TARGET_URL=http://localhost:8080

# Navigation timeout in milliseconds
NAVIGATION_TIMEOUT=30000

# Page ready (networkidle) timeout in milliseconds
PAGE_READY_TIMEOUT=10000

# =========================
# CAPTCHA Configuration
# =========================

# CAPTCHA detection timeout (how long to wait for CAPTCHA to appear)
CAPTCHA_DETECTION_TIMEOUT=15000

# CAPTCHA completion timeout (how long to wait for manual completion)
# Default: 300000 (5 minutes)
CAPTCHA_COMPLETION_TIMEOUT=300000

# Enable CAPTCHA test mode (looks for test-mode signals)
CAPTCHA_TEST_MODE=false

# CAPTCHA test mode selectors
CAPTCHA_SUCCESS_SELECTOR=[data-captcha-success]
CAPTCHA_COMPLETION_SELECTOR=[data-captcha-completed]
CAPTCHA_FAILURE_SELECTOR=[data-captcha-failed]

# =========================
# Interaction Configuration
# =========================

# Delay between mouse actions in milliseconds (for realistic behavior)
INTERACTION_DELAY=100

# Mouse move duration in milliseconds
MOUSE_MOVE_DELAY=300

# Wait time after click before next action
CLICK_WAIT_DELAY=200

# =========================
# Logging Configuration
# =========================

# Log directory
LOG_DIR=./logs

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable screenshot capture on errors
SCREENSHOT_ON_ERROR=true

# Screenshot directory
SCREENSHOT_DIR=./screenshots

# Enable video recording (Playwright feature)
RECORD_VIDEO=false

# Video directory
VIDEO_DIR=./videos

# =========================
# Retry Configuration
# =========================

# Maximum retries for failed operations
MAX_RETRIES=3

# Delay between retries in milliseconds
RETRY_DELAY=1000

# =========================
# Debug Configuration
# =========================

# Enable verbose debug logging
DEBUG=false

# Print network traffic details
NETWORK_DEBUG=false

# Keep browser open after test finishes (for debugging)
KEEP_BROWSER_OPEN=false
