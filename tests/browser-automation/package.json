{
  "name": "gth-browser-automation",
  "version": "1.0.0",
  "description": "Playwright-based browser automation module for GTH testing",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --watch --test tests/**/*.test.js",
    "test:manual": "node scripts/manual-interaction-test.js",
    "test:captcha": "node scripts/captcha-workflow-test.js",
    "test:integration": "node tests/integration.test.js",
    "dev": "node scripts/dev-server.js"
  },
  "keywords": ["gth", "playwright", "browser-automation", "captcha", "testing"],
  "author": "GTH Development",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0",
    "dotenv": "^21.4.0"
  },
  "devDependencies": {
    "node-test-utils": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
